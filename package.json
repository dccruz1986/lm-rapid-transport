{
  "name": "lm-rapid-transport",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@lm/web",
    "build:admin": "turbo run build --filter=@lm/admin",
    "start:web": "node scripts/start.mjs web",
    "start:admin": "node scripts/start.mjs admin",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "bun test",
    "db:start": "supabase start",
    "db:migrate": "supabase migration up --local",
    "db:test": "supabase test db",
    "env:local": "bun scripts/local-env.ts",
    "test:integration": "bun tests/local-integration.ts",
    "test:intake": "bun tests/intake-integration.ts"
  },
  "devDependencies": {
    "@supabase/ssr": "0.12.7",
    "supabase": "2.120.0",
    "@lm/validation": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "^6.0.3",
    "turbo": "2.11.7"
  }
}
