# Copy into BOTH apps/web/.env.local and apps/admin/.env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
INTAKE_HASH_SECRET=replace-with-at-least-32-random-characters
# Set only after confirming a proxy OVERWRITES this header in production.
TRUSTED_IP_HEADER=
CONTACT_PHONE=+13059812778
CONTACT_EMAIL=86adrianlopez@gmail.com


# Google Places API (New) + Geocoding API; server only. Empty enables manual intake.
GOOGLE_MAPS_SERVER_API_KEY=

# Browser Maps JavaScript API + Places API (New); restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Admin map ID. Use your own Map ID in production; development uses DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
