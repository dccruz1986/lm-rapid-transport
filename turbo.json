{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "TEST_WEB_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SECRET_KEY",
    "WEB_URL",
    "ADMIN_URL",
    "CONTACT_EMAIL",
    "CONTACT_PHONE",
    "TRUSTED_IP_HEADER",
    "INTAKE_HASH_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
